# Production Environment Template
# Copy this file to .env and populate with deployment credentials.
# NEVER commit raw private keys or seed phrases to version control.

ENVIRONMENT_TIER=testnet

# Blockchain RPC Endpoints
SOLANA_RPC_URL=https://api.devnet.solana.com
ETHEREUM_SEPOLIA_RPC=https://rpc.sepolia.org
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
ALGORAND_NODE_URL=https://testnet-api.algonode.cloud

# AI & Quantum Providers
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
IBM_QUANTUM_API_KEY=your_ibm_quantum_key_here
